{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "body": [
    {
      "type": "Container",
      "spacing": "none",
      "items": [
        {
          "type": "TextBlock",
          "text": {{AuthTitle}},
          "wrap": true,
          "horizontalAlignment": "center",
          "height": "stretch",
          "size": "medium",
          "weight": "bolder"
        },
        {
          "type": "Image",
          "url": {{AuthIcon}},
          "horizontalAlignment": "center",
          "size": "large"
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch"
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "ActionSet",
                  "actions": [
                    {
                      "title": {{AuthButtonTitle}},
                      "tooltip": {{AuthButtonTooltip}},
                      "type": "Action.Submit",
                      "style": "positive",
                      "isEnabled": {{ButtonIsEnabled}},
                      "data": {
                        "action": "signIn"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch"
            }
          ]
        },
        {
          "type": "ColumnSet",
          "spacing": "small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch"
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "ActionSet",
                  "actions": [
                    {
                      "title": {{EnterpriseLinkTitle}},
                      "tooltip": {{EnterpriseLinkTooltip}},
                      "type": "Action.Submit",
                      "isEnabled": {{ButtonIsEnabled}},
                      "data": {
                        "action": "showEnterprise"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch"
            }
          ]
        }
      ]
    }
  ]
}
